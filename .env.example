# ---------------------------------------------------------------------------
# Database — Supabase Postgres
#
# Copy both strings from: Supabase dashboard -> Project Settings -> Database
# -> Connection string -> "ORMs" / Prisma tab.
#
# DATABASE_URL  pooled  (port 6543, "Transaction pooler")  — used by the app
# DIRECT_URL    direct  (port 5432, "Direct connection")   — used by migrations
#
# Both are required: migrations cannot run over the transaction pooler.
# Keep ?pgbouncer=true on the pooled URL — it disables prepared statements,
# which the pooler does not support.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js v5
# Generate a secret with: npx auth secret
# AUTH_URL is used to build password-reset and verification links.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider
#   mock   — built-in demo engine, no API key needed (default)
#   claude — live Claude API, requires ANTHROPIC_API_KEY
#
# Opportunity scores are computed by the deterministic scoring rules in both
# cases; the provider only changes the language around them.
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Platform adapters
#   mock — bundled demo fixtures, clearly labelled in the UI (default)
#   live — official API (Reddit only; X and LinkedIn have no live adapter yet)
# ---------------------------------------------------------------------------
REDDIT_ADAPTER="mock"
X_ADAPTER="mock"
LINKEDIN_ADAPTER="mock"

# Required when REDDIT_ADAPTER=live. Create a "script" app at
# https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USER_AGENT="web:launchpad-catalyst:v1.0 (by /u/yourusername)"

# ---------------------------------------------------------------------------
# Email
#   console — writes messages to the server log (default; nothing is delivered)
# ---------------------------------------------------------------------------
MAIL_PROVIDER="console"
