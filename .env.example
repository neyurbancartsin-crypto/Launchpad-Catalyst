# ---------------------------------------------------------------------------
# Database — Supabase Postgres
#
# Copy both strings from: Supabase dashboard -> Project Settings -> Database
# -> Connection string -> "ORMs" / Prisma tab.
#
# DATABASE_URL  pooled  (port 6543, "Transaction pooler")  — used by the app
# DIRECT_URL    direct  (port 5432, "Direct connection")   — used by migrations
#
# Both are required: migrations cannot run over the transaction pooler.
# Keep ?pgbouncer=true on the pooled URL — it disables prepared statements,
# which the pooler does not support.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js v5
# Generate a secret with: npx auth secret
# AUTH_URL is used to build password-reset and verification links.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI provider
#   mock       — built-in demo engine, no API key needed (default)
#   claude     — live Claude API, requires ANTHROPIC_API_KEY
#   openrouter — live OpenRouter API, requires OPENROUTER_API_KEY
#   gemini     — live Google Gemini API, requires GEMINI_API_KEY
#
# Opportunity scores are computed by the deterministic scoring rules in every
# case; the provider only changes the language around them.
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"

# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=""
# Default is "openrouter/free" — OpenRouter's own router across free models
# on its platform, chosen because it keeps working as individual free models
# get deprecated or rate-limited. Override with any model slug from
# https://openrouter.ai/models (paid models will incur real cost).
# OPENROUTER_MODEL="openrouter/free"

# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# Default is "gemini-2.5-flash". Override with any model name from
# https://ai.google.dev/gemini-api/docs/models.
# GEMINI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# Platform adapters — active MVP platforms
#   mock — bundled demo fixtures, clearly labelled in the UI (default)
#   live — official API
#
# None of these three need OAuth or per-user account connection: all public
# discovery below reads public data with app-level (or no) credentials.
# ---------------------------------------------------------------------------
GITHUB_ADAPTER="mock"
HACKERNEWS_ADAPTER="mock"
STACKOVERFLOW_ADAPTER="mock"

# Optional even when GITHUB_ADAPTER=live: public issue search works
# unauthenticated (10 requests/min). A classic personal access token with NO
# scopes raises that to 30 requests/min. Create one at
# https://github.com/settings/tokens
# GITHUB_TOKEN=""

# Hacker News needs no credentials, ever — the Algolia HN Search API
# (hn.algolia.com) is free and keyless.

# Optional even when STACKOVERFLOW_ADAPTER=live: reading public Q&A needs no
# OAuth. An app key just raises the daily quota from 300 to 10,000 requests.
# Register a free app at https://stackapps.com
# STACKOVERFLOW_APP_KEY=""

# ---------------------------------------------------------------------------
# Platform adapters — deferred (kept working, not part of the active MVP)
#   mock — bundled demo fixtures, clearly labelled in the UI (default)
#   live — official API (Reddit only; X and LinkedIn have no live adapter yet)
# ---------------------------------------------------------------------------
REDDIT_ADAPTER="mock"
X_ADAPTER="mock"
LINKEDIN_ADAPTER="mock"

# Required when REDDIT_ADAPTER=live. Create a "script" app at
# https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""
# REDDIT_USER_AGENT="web:launchpad-catalyst:v1.0 (by /u/yourusername)"

# ---------------------------------------------------------------------------
# Email
#   console — writes messages to the server log (default; nothing is delivered)
# ---------------------------------------------------------------------------
MAIL_PROVIDER="console"

# ---------------------------------------------------------------------------
# Background discovery cron
#
# Authorizes POST/GET /api/cron/discovery. Generate a long random value
# (e.g. `openssl rand -hex 32`). Required for the endpoint to work at all —
# with no secret configured it always returns 503, never runs unauthenticated.
#
# On Vercel: set this as a project environment variable and Vercel's own
# cron invocations (see vercel.json) automatically send it as
# `Authorization: Bearer <value>`. Elsewhere, trigger the same endpoint with
# any scheduler that can send that header.
# ---------------------------------------------------------------------------
# CRON_SECRET=""
